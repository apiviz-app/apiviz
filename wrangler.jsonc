// Publication sur Cloudflare (IT-29) : trois Workers qui ne servent que des fichiers statiques.
//   - apiviz          : l'application en production, app.apiviz.fr
//   - apiviz-recette  : l'application en recette, recette.apiviz.fr (--env recette)
//   - apiviz-site     : le site vitrine, apiviz.fr (--env site), dossier site/
// Les dossiers de l'application sont préparés par l'action « Mise en ligne » à partir du site assemblé (_site) :
// la racine sans /recette pour la production, /recette pour la recette. Le site vitrine part par l'action « Site vitrine ».
// Cloudflare crée lui-même les enregistrements DNS et les certificats HTTPS des domaines ci-dessous.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "apiviz",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./_cloudflare/production" },
  "routes": [{ "pattern": "app.apiviz.fr", "custom_domain": true }],
  "workers_dev": false,
  "env": {
    "recette": {
      "name": "apiviz-recette",
      "assets": { "directory": "./_cloudflare/recette" },
      "routes": [{ "pattern": "recette.apiviz.fr", "custom_domain": true }],
      "workers_dev": false
    },
    "site": {
      "name": "apiviz-site",
      "assets": { "directory": "./site" },
      "routes": [{ "pattern": "apiviz.fr", "custom_domain": true }],
      "workers_dev": false
    }
  }
}
